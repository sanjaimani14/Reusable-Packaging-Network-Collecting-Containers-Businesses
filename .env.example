# RePackAI Configuration Environment Variables

# Project Settings
PROJECT_NAME=RePackAI

# Database Configuration
# Use SQLite for local development:
DATABASE_URL=sqlite:///./repackai.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/repackai

# Security Settings
SECRET_KEY=yoursecretsecuritykeyhere
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Recommendation Weight Matrix (Must sum to 1.0)
WEIGHT_FINANCIAL=0.40
WEIGHT_ENVIRONMENTAL=0.30
WEIGHT_REUSABILITY=0.20
WEIGHT_OPERATIONAL=0.10

# ML Files Paths
MODEL_PATH=models/repack_model.joblib
DATASET_PATH=data/synthetic/synthetic_containers.csv
